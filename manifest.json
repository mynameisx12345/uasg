  "shortcuts": [
    {
      "name": "Upload File",
      "short_name": "Upload",
      "description": "Quick upload files",
      "url": "/uasg/admin/file-management.php",
      "icons": [{ "src": "resources/icons/upload-icon.png", "sizes": "96x96" }]
    },
    {
      "name": "Admin Panel",
      "short_name": "Admin",
      "description": "Access admin panel",
      "url": "/uasg/admin/",
      "icons": [{ "src": "resources/icons/admin-icon.png", "sizes": "96x96" }]
    }
  ],
  "share_target": {
    "action": "/uasg/admin/file-management.php",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": ["image/*", "application/pdf", ".doc", ".docx", ".xls", ".xlsx", ".ppt", ".pptx"]
        }
      ]
    }
  }
}